# Production Environment
# This file is for building the frontend for production deployment
# Deployed to: CLIENT'S DOMAIN (TBD)

# Backend API URL (Cloudflare Worker - production)
# UPDATE THIS with client's production worker domain
VITE_API_URL=https://api.client-domain.com

# Note: NODE_ENV is automatically set by Vite build command
# Don't set NODE_ENV here - it will cause an error

# Before deploying to production:
# 1. Update VITE_API_URL with client's API domain
# 2. Ensure the worker is deployed to client's Cloudflare account
# 3. Verify CORS settings in the worker match this domain
