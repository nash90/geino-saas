{
	"name": "worker",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"deploy": "pnpm run deploy:staging",
		"deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
		"deploy:production": "wrangler deploy --config wrangler.production.jsonc",
		"secrets:staging": "node scripts/set-secrets.js staging",
		"secrets:production": "node scripts/set-secrets.js production",
		"tail:staging": "wrangler tail geino-saas-staging",
		"tail:production": "wrangler tail geino-saas-prod"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.8.19",
		"dotenv": "^17.2.3",
		"drizzle-kit": "^0.31.7",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.56.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.948.0",
		"@aws-sdk/s3-request-presigner": "^3.948.0",
		"@supabase/supabase-js": "^2.86.0",
		"drizzle-orm": "^0.44.7",
		"hono": "^4.10.7",
		"postgres": "^3.4.7",
		"resend": "^6.6.0"
	}
}