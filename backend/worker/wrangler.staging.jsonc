/**
 * Wrangler Configuration - Staging Environment
 * Deploys to YOUR Cloudflare account
 * Domain: geinosaas.yamacity.com
 *
 * Deploy with: pnpm deploy:staging
 * Set secrets with: wrangler secret put <KEY_NAME> --env staging
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "geino-saas-staging",
	"main": "src/index.ts",
        "compatibility_date": "2025-11-28",
        "compatibility_flags": ["nodejs_compat"],
        "workers_dev": true,

        "observability": {
                "enabled": true
        },	/**
	 * Environment Variables (Non-sensitive)
	 */
	"vars": {
		"APP_URL": "https://geinosaas.yamacity.com",
		"ENVIRONMENT": "staging"
	},

        /**
         * Routes - Bind to custom domain
         * You need to add this route in Cloudflare Dashboard:
         * Workers & Pages > geino-saas-staging > Settings > Triggers > Routes
         * Add: api-geinosaas.yamacity.com/*
         */
        "routes": [
                {
                        "pattern": "api-geinosaas.yamacity.com/*",
                        "zone_name": "yamacity.com"
                }
        ],	/**
	 * R2 Buckets (for file uploads)
	 * Create bucket first: wrangler r2 bucket create geino-saas-staging-uploads
	 */
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS_BUCKET",
			"bucket_name": "geino-saas-staging-uploads"
		}
	],

	/**
	 * Cloudflare Queues for event-driven notifications
	 */
	"queues": {
		"producers": [
			{
				"binding": "NOTIFICATIONS_QUEUE",
				"queue": "geino-notifications-staging"
			}
		],
		"consumers": [
			{
				"queue": "geino-notifications-staging",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3
			}
		]
	},

	/**
	 * Cron triggers for scheduled tasks (partition management)
	 * Runs on 1st day of each month at midnight UTC
	 */
	"triggers": {
		"crons": ["0 0 1 * *"]
	},

	/**
	 * Secrets (Set via CLI - DO NOT commit these values)
	 * Run these commands after first deployment:
	 *
	 * wrangler secret put SUPABASE_URL --env staging
	 * wrangler secret put SUPABASE_SERVICE_ROLE_KEY --env staging
	 * wrangler secret put DATABASE_URL --env staging
	 * wrangler secret put FROM_EMAIL --env staging
	 * wrangler secret put FROM_NAME --env staging
	 *
	 * Or use bulk upload from .env.staging:
	 * cat .env.staging | grep -v '^#' | grep -v '^$' | while IFS='=' read -r key value; do
	 *   echo "Setting $key..."
	 *   echo "$value" | wrangler secret put "$key" --env staging
	 * done
	 */

	/**
	 * Logpush (Optional - for production monitoring)
	 * Sends logs to external service (e.g., Datadog, Splunk)
	 */
	// "logpush": true,

	/**
	 * Tail Consumers (Optional - for real-time log monitoring)
	 */
	// "tail_consumers": [
	// 	{
	// 		"service": "geino-saas-staging-logs"
	// 	}
	// ]
}
